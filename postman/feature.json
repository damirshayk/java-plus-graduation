  "item": [
    {
      "name": "создание комментария",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const main = async () => {\r",
              "    const api = new API(pm);\r",
              "    const rnd = new RandomUtils();\r",
              "\r",
              "    try {\r",
              "        const author = await api.addUser(rnd.getUser());\r",
              "        pm.collectionVariables.set(\"userId\", author.id);\r",
              "\r",
              "        const initiator = await api.addUser(rnd.getUser());\r",
              "        const category = await api.addCategory(rnd.getCategory());\r",
              "        const event = await api.addEvent(rnd.getEvent(category.id), initiator.id);\r",
              "        await api.publishEvent(event.id);\r",
              "        pm.collectionVariables.set(\"eventId\", event.id);\r",
              "\r",
              "        pm.collectionVariables.set(\"commentText\", rnd.getWord(50));\r",
              "    } catch (err) {\r",
              "        console.error(\"Ошибка при подготовке тестовых данных.\", err);\r",
              "    }\r",
              "};\r",
              "\r",
              "const interval = setInterval(() => {}, 1000);\r",
              "setTimeout(async () => {\r",
              "    try { await main(); }\r",
              "    catch (e) { console.error(e); }\r",
              "    finally { clearInterval(interval); }\r",
              "}, 100);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Ответ в формате JSON\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "pm.test(\"Поля ответа корректны\", function () {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data.text).to.eql(pm.collectionVariables.get(\"commentText\"));\r",
              "    pm.expect(data.eventId).to.eql(Number(pm.collectionVariables.get(\"eventId\")));\r",
              "    pm.expect(data.updatedOn).to.be.null;\r",
              "    pm.collectionVariables.set(\"commentId\", data.id);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
