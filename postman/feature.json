              "    pm.expect(data.length).to.be.greaterThan(0);\r",
              "    pm.expect(data[0]).to.have.property(\"id\");\r",
              "    pm.expect(data[0]).to.have.property(\"text\");\r",
              "    pm.expect(data[0]).to.have.property(\"author\");\r",
              "});"
