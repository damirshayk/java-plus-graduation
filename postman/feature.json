  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "API = class {\r",
          "    constructor(postman, baseUrl = \"http://localhost:8080\") {\r",
          "        this.baseUrl = baseUrl;\r",
          "        this.pm = postman;\r",
          "    }\r",
          "\r",
          "    async addUser(user) {\r",
          "        return this.post(\"/admin/users\", user);\r",
          "    }\r",
          "\r",
          "    async addCategory(category) {\r",
          "        return this.post(\"/admin/categories\", category);\r",
          "    }\r",
          "\r",
          "    async addEvent(event, initiatorId) {\r",
          "        return this.post(\"/users/\" + initiatorId + \"/events\", event);\r",
          "    }\r",
          "\r",
          "    async publishEvent(eventId) {\r",
          "        return this.patch(\"/admin/events/\" + eventId, { stateAction: \"PUBLISH_EVENT\" });\r",
          "    }\r",
          "\r",
          "    async addComment(comment, eventId, userId) {\r",
          "        return this.post(\"/users/\" + userId + \"/events/\" + eventId + \"/comments\", comment);\r",
          "    }\r",
          "\r",
          "    async post(path, body) {\r",
          "        return this.sendRequest(\"POST\", path, body);\r",
          "    }\r",
          "\r",
          "    async patch(path, body = null) {\r",
          "        return this.sendRequest(\"PATCH\", path, body);\r",
          "    }\r",
          "\r",
          "    async sendRequest(method, path, body = null) {\r",
          "        return new Promise((resolve, reject) => {\r",
          "            const req = {\r",
          "                url: this.baseUrl + path,\r",
          "                method: method,\r",
          "                body: body == null ? \"\" : JSON.stringify(body),\r",
          "                header: { \"Content-Type\": \"application/json\" }\r",
          "            };\r",
          "\r",
          "            this.pm.sendRequest(req, (error, response) => {\r",
          "                if (error || response.code >= 400) {\r",
          "                    reject(new Error(JSON.stringify(response.json())));\r",
          "                } else if (response.stream.length === 0) {\r",
          "                    resolve(null);\r",
          "                } else {\r",
          "                    resolve(response.json());\r",
          "                }\r",
          "            });\r",
          "        });\r",
          "    }\r",
          "};\r",
          "\r",
          "RandomUtils = class {\r",
          "    getUser() {\r",
          "        return {\r",
          "            name: pm.variables.replaceIn(\"{{$randomFullName}}\"),\r",
          "            email: pm.variables.replaceIn(\"{{$randomEmail}}\")\r",
          "        };\r",
          "    }\r",
          "\r",
          "    getCategory() {\r",
          "        return { name: this.getWord(15) };\r",
          "    }\r",
          "\r",
          "    getEvent(categoryId) {\r",
          "        const moment = require(\"moment\");\r",
          "        return {\r",
          "            annotation: this.getWord(30),\r",
          "            category: categoryId,\r",
          "            description: this.getWord(50),\r",
          "            eventDate: moment().add(2, \"days\").format(\"YYYY-MM-DD HH:mm:ss\"),\r",
          "            location: { lat: 55.75, lon: 37.62 },\r",
